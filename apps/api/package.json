{
  "name": "@nexus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "tsx --env-file-if-exists=.env src/scripts/seed-admin.ts",
    "seed:base": "tsx --env-file-if-exists=.env src/scripts/seed-base.ts",
    "seed:locations": "tsx --env-file-if-exists=.env src/scripts/seed-locations.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/scripts/seed-demo.ts",
    "demo:remove": "tsx --env-file-if-exists=.env src/scripts/remove-demo.ts",
    "db:indexes": "tsx --env-file-if-exists=.env src/scripts/sync-indexes.ts"
  },
  "dependencies": {
    "@nexus/shared": "workspace:*",
    "argon2": "^0.45.0",
    "cloudinary": "^2.7.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.35.0",
    "mongodb-memory-server": "^10.2.0",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.0"
  }
}
