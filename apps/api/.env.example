# ─── NEXUS API — copy to apps/api/.env for local development ───
# Never commit real values. In production set these in the server's env file
# (see docs/DEPLOYMENT.md) or your host's secret manager.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB connection string. Local: mongodb://127.0.0.1:27017/nexus
# Production: MongoDB Atlas SRV string with a dedicated, least-privilege user.
MONGODB_URI=mongodb://127.0.0.1:27017/nexus

# Comma-separated origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
# Number of reverse proxies in front of the API (1 behind Nginx).
TRUST_PROXY=0

# At least 32 random characters:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Website user accounts. SMS_DRIVER: console (dev: prints OTP codes) | msg91 | bulksms (production) | disabled
USER_SESSION_TTL_DAYS=30
SMS_DRIVER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# BulkSMSServiceProviders (SMS_DRIVER=bulksms). Sender/route/template default to the approved DNHIRE OTP template.
BULKSMS_AUTH_KEY=
# Optional: DLT-approved MSG91 Flow that SMSes a poster's number to the visitor (vars: name, phone, title)
MSG91_CONTACT_FLOW_ID=

# Uploads: "local" for development, "cloudinary" required in production.
UPLOAD_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
LOCAL_UPLOAD_PUBLIC_URL=/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nexus-estate/properties

# Optional email alerts for new leads. Recipient is set in Admin → Settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NEXUS Estate <no-reply@example.com>"

# Staff alerts on WhatsApp (Meta WhatsApp Cloud API). Leave empty to turn off.
# The template must be an approved "utility" template with one body variable {{1}}.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=nexus_alert
WHATSAPP_TEMPLATE_LANG=en

# Razorpay for paid plans. Leave empty to turn online payment off (manual payments still work).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret of the Razorpay webhook (URL: https://<site>/api/v1/webhooks/razorpay,
# events payment.captured and order.paid). Backup for when a buyer closes the tab mid-payment.
RAZORPAY_WEBHOOK_SECRET=

ENABLE_API_DOCS=true
PUBLIC_CACHE_SECONDS=60
